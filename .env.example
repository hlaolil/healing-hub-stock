# Copy this file to .env for local development. .env is never committed.

# Database: the local MongoDB from docker-compose.yml
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=healing_hub

# Any long random text; required, or the app will not start
SECRET_KEY=change-me-to-a-long-random-string
# Lets you open /register and create the first admin account
ADMIN_PASSWORD=choose-an-admin-password
PORT=5000

# Link to the website running locally (npm run dev in healing-hub-pharmacy)
WEBSITE_URL=http://localhost:3000
WEBSITE_ORIGIN=http://localhost:3000
# Must be the same value as TILL_SYNC_SECRET in the website's .env.local
TILL_SYNC_SECRET=local-sync-secret

# Optional: owner emails through Gmail (leave blank to skip)
GMAIL_USER=
GMAIL_APP_PASSWORD=
OWNER_EMAIL=
# Lets you trigger the evening job by hand (see README)
CRON_SECRET=local-cron-secret
